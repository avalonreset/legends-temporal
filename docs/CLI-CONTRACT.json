{
  "schema": "legends.cli-contract/v1",
  "module": "legends-temporal",
  "version": "0.1.0",
  "entrypoints": ["legends-temporal", "python -m legends_temporal"],
  "global_flags": {
    "--profile": "named profile from the config file (default: default_profile, then detected, then built-in local)",
    "--config": "config file path (default: $LEGENDS_TEMPORAL_CONFIG or ~/.legends-temporal/config.json)",
    "--address": "host:port override (beats env and profile)",
    "--namespace": "namespace override (beats env and profile)",
    "--timeout": "connect timeout seconds",
    "--json": "machine-readable JSON on stdout"
  },
  "env": {
    "TEMPORAL_ADDRESS": "address override below --address",
    "TEMPORAL_NAMESPACE": "namespace override below --namespace",
    "TEMPORAL_API_KEY": "API key (name configurable per profile via api_key_env); forces TLS",
    "TEMPORAL_TLS_CERT": "client cert path for mTLS",
    "TEMPORAL_TLS_KEY": "client key path for mTLS",
    "TEMPORAL_TLS_CA": "server CA bundle path",
    "LEGENDS_TEMPORAL_CONFIG": "config file path"
  },
  "exit_codes": {
    "0": "ok",
    "1": "error",
    "2": "usage error",
    "3": "not found",
    "4": "workflow failed (start --wait, job run, timer --wait)",
    "5": "cannot connect to the Temporal frontend"
  },
  "mutating": [
    "config init",
    "schedule create", "schedule apply", "schedule trigger", "schedule pause", "schedule unpause", "schedule delete", "schedule backfill",
    "timer in",
    "workflow start", "workflow signal", "workflow cancel", "workflow terminate",
    "job run",
    "worker"
  ],
  "dry_run_capable": ["schedule create", "schedule apply", "timer in"],
  "confirm_required": {"schedule delete": "--yes", "workflow terminate": "--yes"},
  "commands": {
    "version": [],
    "agents": [],
    "doctor": ["--live"],
    "resources": [],
    "config show": [],
    "config init": ["--path"],
    "namespace list": [],
    "namespace describe": ["<name>"],
    "queue describe": ["<task_queues>"],
    "schedule list": ["--query"],
    "schedule describe": ["<schedule_id>"],
    "schedule create": ["--id", "--title", "--cron", "--interval", "--timezone", "--overlap", "--catchup-window", "--jitter", "--remaining-actions", "--paused", "--script", "--code", "--args", "--arg", "--session", "--spawn", "--agent", "--message", "--model", "--effort", "--type", "--project", "--workspace", "--cwd", "--notify-channel", "--queue", "--interpreter", "--timeout-s", "--dry-run"],
    "schedule apply": ["--file", "--from-python", "--pythonpath", "--only", "--dry-run"],
    "schedule trigger": ["<schedule_id>", "--overlap"],
    "schedule pause": ["<schedule_id>", "--note"],
    "schedule unpause": ["<schedule_id>", "--note"],
    "schedule delete": ["<schedule_id>", "--yes"],
    "schedule backfill": ["<schedule_id>", "--start", "--end", "--overlap"],
    "timer in": ["<delay>", "--command", "--webhook-env", "--body", "--job-id", "--wait", "--wait-timeout", "--dry-run", "--script", "--code", "--args", "--arg", "--session", "--spawn", "--agent", "--message", "--model", "--effort", "--type", "--project", "--workspace", "--cwd", "--title", "--notify-channel", "--queue", "--interpreter", "--timeout-s"],
    "workflow list": ["--status", "--type", "--id-prefix", "--query", "--limit"],
    "workflow describe": ["<workflow_id>", "--run-id"],
    "workflow history": ["<workflow_id>", "--run-id", "--diagnose", "--limit", "--tail-lines"],
    "workflow start": ["<wf_type>", "--id", "--queue", "--input", "--start-delay", "--execution-timeout", "--wait", "--wait-timeout"],
    "workflow signal": ["<workflow_id>", "<name>", "--input", "--run-id"],
    "workflow query": ["<workflow_id>", "<name>", "--input", "--run-id"],
    "workflow cancel": ["<workflow_id>", "--run-id"],
    "workflow terminate": ["<workflow_id>", "--reason", "--yes", "--run-id"],
    "job list": ["--from-python", "--pythonpath", "--canary"],
    "job run": ["<job_id>", "--no-wait", "--run-timeout", "--from-python", "--pythonpath", "--canary"],
    "worker": ["--role", "--log-file", "--max-concurrent"],
    "mcp": []
  },
  "mcp_tools": [
    "temporal_doctor",
    "temporal_namespace_list",
    "temporal_queue_describe",
    "temporal_schedule_list",
    "temporal_schedule_describe",
    "temporal_workflow_list",
    "temporal_workflow_diagnose",
    "temporal_timer_schedule"
  ],
  "wire_contract": {
    "workflow_type": "ScriptJob",
    "payload_fields": ["job_id", "title", "queue", "interpreter", "script", "args", "cwd", "timeout_s", "wait_for_worker_s", "notify_channel", "cron"],
    "activities": {"run_script": "exec queue (job.queue)", "notify_buzz": "exec queue (job.queue)", "log_failure": "workflow queue"}
  }
}
